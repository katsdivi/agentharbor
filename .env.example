# remote-browser-accounts configuration template. Create your .env with
# `npm run init-env` (never overwrites an existing .env; see docs/INSTALL.md for where
# it goes). Keep .env at mode 600; it is gitignored and excluded from packages.
# Every value below is a placeholder or a default: bring your own credentials.

# --- Apify (remote browser provider) ------------------------------------------
# Personal API token: https://console.apify.com/settings/integrations
APIFY_TOKEN=REPLACE_ME
# Printed by `npm run deploy-actor`, e.g. yourname~remote-browser-worker
APIFY_ACTOR_ID=REPLACE_ME
# Optional: pin a worker Actor build (tag or number, e.g. 0.1.3). Default: latest build.
# APIFY_ACTOR_BUILD=
# APIFY_API_BASE_URL=https://api.apify.com

# --- MailSlurp (receiving verification email) ----------------------------------
# https://app.mailslurp.com -> API key
MAILSLURP_API_KEY=REPLACE_ME
# 0 = permanent inbox (needed for later password resets; free plan retains 50)
RBA_INBOX_EXPIRES_HOURS=0
# Use MailSlurp's domain pool when creating inboxes (chosen up front, never as a retry)
RBA_MAILSLURP_USE_DOMAIN_POOL=false
RBA_MAILSLURP_MAX_INBOXES_PER_MONTH=90
RBA_MAILSLURP_MAX_EMAILS_PER_MONTH=450

# --- Local secrets (generated by init-env; never printed) ----------------------
RBA_ENCRYPTION_KEY=REPLACE_ME
RBA_DASHBOARD_TOKEN=REPLACE_ME

# --- Authorised targets ----------------------------------------------------------
# Comma-separated. Each entry: target origin, optionally followed by |auth origins.
# Accounts can only be created/used on these origins, and verification links are
# only followed to them. Example:
#   RBA_AUTHORIZED_TARGETS=https://app.example.com|https://auth.example.com
RBA_AUTHORIZED_TARGETS=
# Exact origins that sessions NOT bound to an account may navigate to (comma-separated).
# Empty = such sessions cannot navigate. "*" (any public site) only if you really mean it.
# This is the browser's navigation policy, not dashboard CORS.
RBA_ALLOWED_ORIGINS=
# Extra origins pages may load RESOURCES from: iframes, scripts, styles, images,
# fetch/XHR, WebSockets, workers, and redirect hops of those. Navigation origins are
# always included. Exact origins or https://*.example.com; "*" only explicitly.
# Use session_network_log to see which hosts a site needed and were refused.
RBA_SUBRESOURCE_ORIGINS=
# Explicitly authorised PRIVATE test hosts (host or host:port). Leave empty.
RBA_ALLOW_PRIVATE_HOSTS=
# Optional, for demos: record a video (1920x1080 .webm) of every page of LOCAL-mode
# workers into this directory. Remote workers never record. Leave empty normally.
RBA_LOCAL_RECORD_VIDEO_DIR=

# --- Routing -------------------------------------------------------------------
# Default execution mode: local | remote_direct | remote_proxy. Unset = derived from
# RBA_DEFAULT_PROXY_MODE (direct -> remote_direct), which keeps existing installs unchanged.
# RBA_DEFAULT_EXECUTION_MODE=

# --- Saved read operations (optional, off by default) -----------------------------
# true enables operation_learn / operation_call / ... (reviewed READ requests replayed
# inside the browser worker in the session's execution mode). Off: those tools return
# config_missing and nothing else changes.
# RBA_OPERATIONS_ENABLED=false
# direct | datacenter | residential (proxy modes fail closed if unverifiable)
RBA_DEFAULT_PROXY_MODE=direct
# RBA_PROXY_COUNTRY=US
RBA_EGRESS_CHECK_URL=https://api.apify.com/v2/browser-info

# --- Limits and spending ---------------------------------------------------------
# Conservative defaults for the Apify free plan ($5/month). The gate counts unsettled
# runs at max(preliminary figure, local estimate) because billing settles late.
RBA_MONTHLY_BUDGET_USD=1.00
# Used for estimates only (USD per Apify compute unit). Look up your own plan's price;
# a higher value is more conservative.
RBA_APIFY_CU_PRICE_USD=0.2
# Power of two (512..8192)
RBA_WORKER_MEMORY_MB=2048
# Residential traffic reserved in the budget per residential session; the session is stopped when exceeded
RBA_RESIDENTIAL_RESERVE_GB=0.02
RBA_RESIDENTIAL_GB_PRICE_USD=8
RBA_MAX_CONCURRENT_SESSIONS=1
RBA_MAX_SESSION_MINUTES=10
RBA_IDLE_TIMEOUT_SECS=180
RBA_MAX_CRAWL_PAGES=50
RBA_MAX_CRAWL_DEPTH=3
RBA_MAX_RETRIES=2
RBA_EMAIL_WAIT_MAX_SECS=600
RBA_MAX_UPLOAD_MB=10
RBA_LEASE_TTL_SECS=120

# --- Local data ------------------------------------------------------------------
# Defaults to ./data next to this file (the data belongs with this file's encryption key). Uploads are only allowed from
# <data>/uploads plus RBA_UPLOAD_ROOTS (comma-separated absolute paths).
# RBA_DATA_DIR=./data
RBA_UPLOAD_ROOTS=
RBA_LOG_RETENTION_DAYS=30
RBA_ARTIFACT_RETENTION_DAYS=14
RBA_DASHBOARD_PORT=4777

# --- Local files (file_import, media_*, portal_upload) ---------------------------
# Folders file_import may read from (comma-separated; ~ allowed). Empty = only the
# local dashboard file picker (npm run dashboard -- --open, Files page).
RBA_IMPORT_ROOTS=
# Largest file that can be imported (MB). Uploads to a portal are additionally limited
# by RBA_MAX_UPLOAD_MB (sent to the remote worker in one request).
RBA_MAX_IMPORT_MB=200
# Images larger than this (width x height, from headers) are refused before decoding.
RBA_MAX_IMAGE_MEGAPIXELS=100
# Wall-clock limit for one local tool run (ffmpeg, ffprobe, poppler).
RBA_MEDIA_TOOL_TIMEOUT_SECS=300

# --- Display -----------------------------------------------------------------------
# Label shown as the MCP server title and on dashboard pages (1-64 characters). It never
# changes the plugin id (remote-browser-accounts) or tool names.
# RBA_DISPLAY_NAME=Remote Browser Accounts
